# Wzór pliku środowiskowego. Skopiuj do `.env.local` i wstaw prawdziwe wartości.
# `.env.local` jest w .gitignore i nigdy nie trafia do repozytorium.

# ── do aplikacji (jawne, chronione przez RLS) ──
EXPO_PUBLIC_SUPABASE_URL=https://TWOJ_PROJEKT.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...

# ── tylko po stronie serwera ──
# Tych dwóch NIE wstawiaj do aplikacji ani do app.json. Idą do Supabase:
#   supabase secrets set GEMINI_API_KEY=...
#   supabase secrets set GOOGLE_MAPS_API_KEY=...
# Da się je wyciągnąć z każdej paczki mobilnej, a rachunek idzie na właściciela.
